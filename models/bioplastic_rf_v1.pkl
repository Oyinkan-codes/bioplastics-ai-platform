import os
import joblib
import numpy as np
from sklearn.ensemble import RandomForestRegressor

# Define folder and file path
MODEL_DIR = "models"
MODEL_PATH = os.path.join(MODEL_DIR, "bioplastic_rf_v1.pkl")

# 1. Generate Synthetic Training Dataset (500 Formulation Trials)
np.random.seed(42)
N = 500

# Features (Inputs): Formulation Ratios
glycerin = np.random.uniform(5, 40, N)      # Plasticizer (g)
water = np.random.uniform(10, 50, N)         # Solvent (g)
citric_acid = np.random.uniform(0.5, 5.0, N) # Cross-linker (g)
chitosan = np.random.uniform(0.0, 3.0, N)    # Reinforcement agent (g)

X = np.column_stack([glycerin, water, citric_acid, chitosan])

# Targets (Outputs): Material Performance Properties
# - Tensile Strength (MPa)
# - Elasticity / Elongation (%)
# - Water Absorption (%)
tensile = 50.0 - (glycerin * 0.9) - (water * 0.4) + (citric_acid * 2.5) + (chitosan * 3.1) + np.random.normal(0, 1, N)
elasticity = 2.0 + (glycerin * 2.2) + (water * 0.3) - (citric_acid * 0.8) + np.random.normal(0, 1, N)
water_abs = 15.0 + (water * 0.8) - (glycerin * 0.1) - (citric_acid * 1.5) - (chitosan * 2.0) + np.random.normal(0, 1, N)

y = np.column_stack([tensile, elasticity, water_abs])

# 2. Train Multi-Output Random Forest Regressor
model = RandomForestRegressor(n_estimators=30, random_state=42)
model.fit(X, y)

# 3. Serialize and Save Binary Object to Disk
os.makedirs(MODEL_DIR, exist_ok=True)
joblib.dump(model, MODEL_PATH)

print(f"Binary model file successfully written to: {MODEL_PATH}")
